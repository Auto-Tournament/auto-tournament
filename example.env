############################################################
# Auto Tournament – Example .env
#
# Copy this file to `.env` at the repo root and adjust values.
# The API reads `.env` via dotenv on startup.
#
# Docker Compose: The docker-compose.yml files use env_file to load
# all variables from .env into the container automatically.
############################################################

##############################
# ---- Core server settings --
##############################

# Environment: development or production (optional; defaults to development)
# NODE_ENV=development

# API port (behind Caddy/Docker this is usually 3000)
PORT=3000

# Session secret for Passport/express-session
# REQUIRED: Generate a strong random value, for example:
#   openssl rand -base64 32
# Without this, sessions won't persist across container restarts
SESSION_SECRET=change-this-session-secret

########################
# ---- Database --------
########################

# Option A: Single DATABASE_URL (preferred in Docker)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auto_tournament

# Option B: Individual DB settings (for local dev without DATABASE_URL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auto_tournament

###############################################
# ---- Machine access (bots, scripts, CI) -----
###############################################

# API tokens let a machine call the admin API without a browser session — a
# Discord bot, a cron job, a deploy script. Human admins keep using Steam/SSO;
# these are only for integrations.
#
# Present a token as either header:
#   Authorization: Bearer <token>
#   X-API-Token: <token>
#
# Two variables decide scope:
#   API_TOKENS          — full admin. Anything an admin can do, including
#                         creating matches, starting tournaments and RCON.
#   API_TOKENS_READONLY — GET/HEAD/OPTIONS only. Enough for scoreboards,
#                         brackets and match state. Prefer this one: most bots
#                         never need to write.
#
# Format: comma- or space-separated entries, each `label:secret` or a bare
# `secret`. The label only appears in logs, so you can tell which integration
# made a call. Secrets are never logged.
#
# Generate one with:
#   openssl rand -hex 32
#
# Minimum secret length is 16 characters; shorter entries are ignored with a
# warning at startup.
#
# LEAVE THESE UNSET unless you actually have an integration. A token in
# API_TOKENS is a full admin credential for your instance.
#
# Full guide, including a worked Discord bot: docs/API.md
#
# API_TOKENS=discord-bot:replace-with-openssl-rand-hex-32
# API_TOKENS_READONLY=scoreboard:replace-with-openssl-rand-hex-32

##############################
# ---- Game catalog -----------
##############################

# A fresh install has no games. The admin installs them from the catalog
# (Modules page, or /welcome/games): game packs and signed code modules such
# as CS2, from our GitHub or from the offline copy inside the image.

# Where the catalog feed lives – optional (default: catalog.json in
# Auto-Tournament/packs on GitHub)
# CATALOG_URL=https://raw.githubusercontent.com/Auto-Tournament/packs/main/catalog.json

# Never fetch the feed; offer only what the image carries (air-gapped LANs) – optional
# CATALOG_OFFLINE=false

# Install the image's game packs on first boot: "all" or a comma-separated
# list of slugs – optional (default: none)
# PREINSTALL_PACKS=

# Extra Ed25519 public keys (base64, comma-separated) that may sign code
# modules, for your own module builds – optional. Anyone who can set this can
# already put code in DATA_DIR/modules, so it grants nothing new.
# MODULE_TRUSTED_KEYS=

###############################
# ---- CS2 server integration -
###############################

# Token used by CS2 servers to authenticate webhooks and match load requests.
# This must match the token configured in Auto Tournament CS2 on your game servers.
# Example (simple random token):
#   SERVER_TOKEN=$(openssl rand -base64 24 | tr -d '=+/')
SERVER_TOKEN=your-server-token-here

# Accept game events that arrive with NO X-Auto-Tournament-Token — a migration shim.
#
# Event ingest (POST /api/events) used to be unauthenticated. Servers
# that MAT configured send the token already, because the webhook config sets
# `at_remote_log_header_key`/`_value` alongside the URL. A server set up by
# hand, or by a much older MAT, may not — and the symptom is a match whose score
# stops moving, which is a horrible thing to diagnose mid-tournament.
#
# Set this to true to buy time, reconnect your servers so they re-fetch
# /api/servers/:id/bootstrap, then unset it. It only accepts a *missing* token,
# never a wrong one — but while it is on, anyone who can reach this API can
# forge match events. MAT warns about it on every boot.
#
# ALLOW_UNAUTHENTICATED_EVENTS=false

# Webhook base URL for Auto Tournament CS2 to send events to the API.
# This should point to your API server (NOT the frontend dev server).
# Examples:
#   - Local dev: http://localhost:3000
#   - Production: http://your-server-ip:3069 or https://your-domain.com
# If not set, auto-detects as http://localhost:{PORT}
# API_BASE_URL=http://localhost:3000

#############################
# ---- Auth providers (SSO) -
#############################

## Shared auth settings

# Public base URL of MAT frontend, used for OAuth redirects (Steam, Discord, etc.).
# Required when you enable any auth provider.
# IMPORTANT: 
#   - Use http:// for local development (e.g., http://localhost:5173 for Vite dev, or :3069 for Docker)
#   - Use https:// for production (e.g., https://your-domain.com)
# The secure cookie flag is automatically set based on this URL (https:// = secure cookies)
FRONTEND_BASE_URL=http://localhost:3069

## Steam (primary – players + admins)

# Enable/disable Steam as an auth provider
AUTH_STEAM_ENABLED=true

# Required: Steam Web API key (obtain from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your-steam-web-api-key

# Optional: Steam64 IDs that should always have admin rights.
#
# Applied on every start: each ID is created as a player if missing and marked
# admin. Additive — it never removes admin from anyone else.
#
# Without this, admin is bootstrapped by "the first player to sign in gets it",
# which only works on an empty database. An instance that already has players
# but no admin (for example after upgrading from 1.x, where the players table
# comes across but nobody is marked admin) has no other way in short of editing
# the database. Set this, restart, sign in.
#
# Comma- or space-separated, 17-digit Steam64 IDs:
# ADMIN_STEAM_IDS=76561198000000001,76561198000000002

## Keycloak (OIDC) – optional

# Example (uncomment and fill in to enable Keycloak SSO for admins):
# AUTH_KEYCLOAK_ENABLED=true
# KEYCLOAK_ISSUER_URL=https://sso.example.com/realms/auto-tournament
# KEYCLOAK_CLIENT_ID=auto-tournament
# KEYCLOAK_CLIENT_SECRET=your-keycloak-secret
#   # In your Keycloak client, set the Redirect URI to:
#   #   FRONTEND_BASE_URL + /api/auth/keycloak/callback
#   #   e.g. http://localhost:3069/api/auth/keycloak/callback

## Discord (OAuth2) – optional

# Example (uncomment and fill in to enable Discord SSO for admins):
# AUTH_DISCORD_ENABLED=true
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_CLIENT_SECRET=your-discord-client-secret
#   # In your Discord application, set the Redirect URL to:
#   #   FRONTEND_BASE_URL + /api/auth/discord/callback
#   #   e.g. http://localhost:3069/api/auth/discord/callback

## GitHub (OAuth2) – optional

# Example (uncomment and fill in to enable GitHub sign-in):
# AUTH_GITHUB_ENABLED=true
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
#   # In your GitHub OAuth app, set the Authorization callback URL to:
#   #   FRONTEND_BASE_URL + /api/auth/github/callback
#   #   e.g. http://localhost:3069/api/auth/github/callback
#   # Requested scope: read:user

## Google (OAuth2) – optional

# Example (uncomment and fill in to enable Google sign-in):
# AUTH_GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
#   # In your Google OAuth client (type "Web application"), add this
#   # Authorized redirect URI:
#   #   FRONTEND_BASE_URL + /api/auth/google/callback
#   #   e.g. http://localhost:3069/api/auth/google/callback
#   # Requested scopes: openid email profile

# Discord, Keycloak, GitHub and Google logins do not grant admin on their own.
# The first time someone signs in with one of them, they are asked to connect
# Steam. After that, the provider signs them in as that Steam account, and
# admin access follows that player's admin flag (see ADMIN_STEAM_IDS above).

############################
# ---- Logging & debug ----
############################

# Log level: trace | debug | info | warn | error | fatal
# When LOG_LEVEL=debug, DB verbose and DB values logging are enabled automatically.
LOG_LEVEL=info

# Set to false to disable per-request HTTP logs (still logs 4xx/5xx) – optional
# LOG_HTTP_REQUESTS=true

# Per-query DB logs (SQL, params, row counts). Auto-enabled when LOG_LEVEL=debug.
# LOG_DB_VERBOSE=true

# When DB verbose is on, also log result rows (redacted). Auto-enabled when LOG_LEVEL=debug.
# Set LOG_DB_VALUES=false to disable even in debug.
# LOG_DB_VALUES=false

# Enable verbose RCON success logs – optional
# LOG_RCON_VERBOSE=false

################################
# ---- CORS / WebSockets ------- 
################################

# Allowed CORS origin(s) for Socket.IO and API (comma-separated) – optional
# In Docker with Caddy, this is usually handled at the proxy layer.
# CORS_ORIGIN=*

#####################################
# ---- Optional: simulation mode ----
#####################################

# Allow enabling "simulation" features in production (advanced) – optional
# AT_ENABLE_SIMULATION_IN_PROD=false

###########################
# ---- Misc / tooling ----
###########################

# GitHub token used by fetchCS2Maps to call the GitHub API – optional
# GITHUB_TOKEN=

# Playwright base URL for E2E tests – optional (defaults to http://localhost:3069 in tests)
# PLAYWRIGHT_BASE_URL=http://localhost:3069

# Steam ID to use for the test admin in Playwright/tests/scripts – optional
# TEST_STEAM_ID=76561198000000001
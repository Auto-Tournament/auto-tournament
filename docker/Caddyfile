# ========================================

# Caddy Configuration for Auto Tournament

# ========================================

# Internal reverse proxy that runs inside Docker container

# Serves everything through a single port (3069)

#

# Routes:

# / → React frontend (SPA)

# /api/\* → Express backend API

# /api-docs\* → Swagger UI and the OpenAPI spec

# /socket.io/\* → Socket.IO WebSocket

# /map-images/\* → Express backend (uploaded images, stored under DATA_DIR)

# /health → Health check endpoint

# ========================================

# Behind another reverse proxy (TLS terminator, Cloudflare Tunnel, NPM, ...),
# Caddy only passes that proxy's X-Forwarded-Proto/-Host/-For through to the
# API when the proxy is trusted; otherwise it overwrites X-Forwarded-Proto with
# "http", the API thinks the site is plain http and hands out ws:// fleet URLs
# to machines that enrolled over https. Private ranges (Docker networks, LAN)
# are trusted by default; set TRUSTED_PROXIES to override, e.g.
# TRUSTED_PROXIES="private_ranges 203.0.113.0/24". Setting FRONTEND_BASE_URL
# to the public https URL also fixes the fleet URLs, whatever the proxy sends.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

:3069 {
	# API and WebSocket proxying (must come before file_server)
	reverse_proxy /api/* localhost:3000
	# /api-docs and /api-docs.json are not under /api/, so without this they
	# fall through to the SPA and the OpenAPI spec comes back as index.html —
	# even though the API advertises both at GET /.
	reverse_proxy /api-docs* localhost:3000
	reverse_proxy /socket.io/* localhost:3000
	reverse_proxy /health localhost:3000
	# Uploaded map images live under DATA_DIR (the mounted volume), not under
	# the /app/public build output Caddy's file_server below is rooted at, so
	# they have to go to Express — which serves them from the one directory
	# config/publicPaths.ts resolves. Without this they'd fall through to the
	# SPA and every map image would come back as index.html.
	reverse_proxy /map-images/* localhost:3000

	# Serve React frontend from /app/public
	root * /app/public

	# Handle SPA routing: try file, then fallback to index.html
	@notAPI {
		not path /api/*
		not path /api-docs*
		not path /socket.io/*
		not path /health
		not path /map-images/*
		file {
			try_files {path} /index.html
		}
	}
	rewrite @notAPI {http.matchers.file.relative}

	# index.html carries the share-preview image URL as a template
	# ({{env `FRONTEND_BASE_URL`}}): crawlers need it absolute.
	@indexHtml path /index.html
	templates @indexHtml

	file_server
}

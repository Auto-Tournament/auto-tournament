{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/host/v1/messages/hello.json",
  "title": "hello (host → platform, ephemeral)",
  "description": "First message after the upgrade (FLEET.md §6.1, §18). The platform answers welcome or closes (4400 protocol error, 4403 host_id does not match the token, 4426 unsupported protocol). stream: the host's outbound stream of reliable messages (host.result, host.health, auth.rotated), kept in memory: a new id per agent start, so a restarted agent always resets; last_rx_seq is persisted, so commands already handled are not replayed.",
  "type": "object",
  "required": [
    "host_id",
    "machine_id",
    "tenant_id",
    "protocol",
    "versions",
    "capabilities",
    "hostname",
    "boot_id",
    "stream"
  ],
  "properties": {
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "machine_id": {
      "$ref": "../defs.json#/$defs/machineId"
    },
    "tenant_id": {
      "$ref": "../defs.json#/$defs/tenantId"
    },
    "protocol": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "csm"
      ],
      "properties": {
        "csm": {
          "type": "string",
          "maxLength": 64
        },
        "os": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 128,
      "uniqueItems": true,
      "description": "host.v1, servers.start_stop, servers.create, servers.remove_last, update.game, update.plugins, updates.hold, logs.tail, logs.follow, health.v1"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "boot_id": {
      "$ref": "../defs.json#/$defs/ulid"
    },
    "stream": {
      "type": "object",
      "required": [
        "id",
        "last_tx_seq",
        "last_rx_seq"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "last_tx_seq": {
          "type": "integer",
          "minimum": 0
        },
        "last_rx_seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

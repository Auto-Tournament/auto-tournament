{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/host/v1/messages/host.health.json",
  "title": "host.health (host → platform)",
  "description": "`hung` = the process runs but /health has not answered for 30 s. csm does not restart on its own during a match; the platform decides. Reliable (recommended) or ephemeral.",
  "type": "object",
  "required": [
    "server",
    "event"
  ],
  "properties": {
    "server": {
      "$ref": "../defs.json#/$defs/serverName"
    },
    "event": {
      "enum": [
        "crashed",
        "exited",
        "hung",
        "recovered",
        "restarted"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "detail": {
      "type": "string",
      "maxLength": 2000
    }
  }
}

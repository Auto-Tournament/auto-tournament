{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/v1/messages/event.round_start.json",
  "title": "event.round_start (server → platform, reliable)",
  "description": "Match event (FLEET.md §8.1), source: round lifecycle. Envelope epoch = the assignment's. `rev` / `patch` continue the MatchState stream (see match.defs.json#/$defs/rev); `data` holds the facts.",
  "type": "object",
  "required": [
    "match_id",
    "map_number",
    "rev",
    "patch",
    "data"
  ],
  "properties": {
    "match_id": {
      "$ref": "../match.defs.json#/$defs/matchId"
    },
    "map_number": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "rev": {
      "$ref": "../match.defs.json#/$defs/rev"
    },
    "patch": {
      "$ref": "../match.defs.json#/$defs/patch"
    },
    "data": {
      "type": "object",
      "required": [
        "round"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "$ref": "../match.defs.json#/$defs/score"
        }
      }
    }
  }
}

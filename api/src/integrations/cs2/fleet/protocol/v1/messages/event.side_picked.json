{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/v1/messages/event.side_picked.json",
  "title": "event.side_picked (server → platform, reliable)",
  "description": "Match event (FLEET.md §8.1), source: knife. Envelope epoch = the assignment's. `rev` / `patch` continue the MatchState stream (see match.defs.json#/$defs/rev); `data` holds the facts.",
  "type": "object",
  "required": [
    "match_id",
    "map_number",
    "rev",
    "patch",
    "data"
  ],
  "properties": {
    "match_id": {
      "$ref": "../match.defs.json#/$defs/matchId"
    },
    "map_number": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "rev": {
      "$ref": "../match.defs.json#/$defs/rev"
    },
    "patch": {
      "$ref": "../match.defs.json#/$defs/patch"
    },
    "data": {
      "type": "object",
      "required": [
        "team",
        "side",
        "picked_by"
      ],
      "properties": {
        "team": {
          "$ref": "../match.defs.json#/$defs/teamKey"
        },
        "side": {
          "$ref": "../match.defs.json#/$defs/side"
        },
        "picked_by": {
          "oneOf": [
            {
              "$ref": "../defs.json#/$defs/u64s"
            },
            {
              "enum": [
                "timeout",
                "console"
              ]
            }
          ]
        }
      }
    }
  }
}

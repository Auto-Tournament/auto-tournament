{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/v1/messages/event.match_restored.json",
  "title": "event.match_restored (server → platform, reliable)",
  "description": "Match event (FLEET.md §8.1), source: restore; critical. Envelope epoch = the assignment's. `rev` / `patch` continue the MatchState stream (see match.defs.json#/$defs/rev); `data` holds the facts.",
  "type": "object",
  "required": [
    "match_id",
    "map_number",
    "rev",
    "patch",
    "data"
  ],
  "properties": {
    "match_id": {
      "$ref": "../match.defs.json#/$defs/matchId"
    },
    "map_number": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "rev": {
      "$ref": "../match.defs.json#/$defs/rev"
    },
    "patch": {
      "$ref": "../match.defs.json#/$defs/patch"
    },
    "data": {
      "type": "object",
      "required": [
        "map_number",
        "round",
        "backup_sha256"
      ],
      "properties": {
        "map_number": {
          "type": "integer",
          "minimum": 1
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "backup_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file": {
          "type": "string",
          "maxLength": 128
        },
        "resume": {
          "type": "boolean",
          "description": "true: the restore of a match.assign resume (failover / move)"
        },
        "from_epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

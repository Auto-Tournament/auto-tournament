{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/v1/messages/event.walkover_choice.json",
  "title": "event.walkover_choice (server → platform, reliable)",
  "description": "Match event (FLEET.md §8.1), source: `.walkover` / `.play` (or the HUD's buttons) from one of rules.full_team.walkover.choosers while the choice is open (walkover.h). The platform decides: a walkover ends the match, play lets it go ahead; either way it sends the match again.",
  "type": "object",
  "required": ["match_id", "map_number", "rev", "patch", "data"],
  "properties": {
    "match_id": {
      "$ref": "../match.defs.json#/$defs/matchId"
    },
    "map_number": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "rev": {
      "$ref": "../match.defs.json#/$defs/rev"
    },
    "patch": {
      "$ref": "../match.defs.json#/$defs/patch"
    },
    "data": {
      "type": "object",
      "required": ["player", "take"],
      "properties": {
        "player": {
          "type": "object",
          "required": ["steamid64", "name"],
          "properties": {
            "steamid64": {
              "$ref": "../defs.json#/$defs/u64s"
            },
            "name": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "take": {
          "type": "boolean",
          "description": "true: take the walkover; false: play them short"
        }
      }
    }
  }
}

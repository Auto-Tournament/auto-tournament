{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/v1/messages/event.chat.json",
  "title": "event.chat (server → platform, reliable)",
  "description": "Match event (FLEET.md §8.1), source: a player's chat line on the match server (all chat or team chat; not chat commands). Envelope epoch = the assignment's. `rev` / `patch` continue the MatchState stream (see match.defs.json#/$defs/rev). The platform posts it in the match's web chat (`match:<match_id>`), where the admins read it; an admin's reply comes back as `cmd say`. There is no answer on the link.",
  "type": "object",
  "required": ["match_id", "map_number", "rev", "patch", "data"],
  "properties": {
    "match_id": {
      "$ref": "../match.defs.json#/$defs/matchId"
    },
    "map_number": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "rev": {
      "$ref": "../match.defs.json#/$defs/rev"
    },
    "patch": {
      "$ref": "../match.defs.json#/$defs/patch"
    },
    "data": {
      "type": "object",
      "required": ["player", "message", "team_only", "at"],
      "properties": {
        "player": {
          "type": "object",
          "required": ["steamid64", "name", "team", "side"],
          "properties": {
            "steamid64": {
              "$ref": "../defs.json#/$defs/u64s"
            },
            "name": {
              "type": "string",
              "maxLength": 256
            },
            "team": {
              "enum": ["team1", "team2", null]
            },
            "side": {
              "enum": ["ct", "t", "spec"]
            }
          }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "the player's text as typed (UTF-8; CS2 caps a chat line at 255 bytes)"
        },
        "team_only": {
          "type": "boolean",
          "description": "true for team chat (say_team)"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "unix ms"
        }
      }
    }
  }
}

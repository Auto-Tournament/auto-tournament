{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/v1/messages/event.rounds_voided.json",
  "title": "event.rounds_voided (server → platform, reliable)",
  "description": "Match event (FLEET.md §8.1), source: restore / restart_map; critical. Envelope epoch = the assignment's. `rev` / `patch` continue the MatchState stream (see match.defs.json#/$defs/rev); `data` holds the facts.",
  "type": "object",
  "required": [
    "match_id",
    "map_number",
    "rev",
    "patch",
    "data"
  ],
  "properties": {
    "match_id": {
      "$ref": "../match.defs.json#/$defs/matchId"
    },
    "map_number": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "rev": {
      "$ref": "../match.defs.json#/$defs/rev"
    },
    "patch": {
      "$ref": "../match.defs.json#/$defs/patch"
    },
    "data": {
      "type": "object",
      "required": [
        "from_round",
        "reason"
      ],
      "properties": {
        "from_round": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "enum": [
            "restore",
            "restart_map",
            "resume"
          ]
        }
      }
    }
  }
}

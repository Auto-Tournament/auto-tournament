{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-tournament.dev/fleet/v1/messages/event.demo.json",
  "title": "event.demo (server → platform, reliable)",
  "description": "Match event (FLEET.md §8.1), source: demo_recorder.h DemoEvent; critical. Envelope epoch = the assignment's. `rev` / `patch` continue the MatchState stream (see match.defs.json#/$defs/rev); `data` holds the facts.",
  "type": "object",
  "required": [
    "match_id",
    "map_number",
    "rev",
    "patch",
    "data"
  ],
  "properties": {
    "match_id": {
      "$ref": "../match.defs.json#/$defs/matchId"
    },
    "map_number": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "rev": {
      "$ref": "../match.defs.json#/$defs/rev"
    },
    "patch": {
      "$ref": "../match.defs.json#/$defs/patch"
    },
    "data": {
      "type": "object",
      "required": [
        "type",
        "map_number",
        "file_name"
      ],
      "properties": {
        "type": {
          "enum": [
            "recording_started",
            "recording_stopped",
            "upload_started",
            "upload_succeeded",
            "upload_failed"
          ]
        },
        "matchid": {
          "type": "integer"
        },
        "map_number": {
          "type": "integer",
          "minimum": 1
        },
        "file_name": {
          "type": "string",
          "maxLength": 255
        },
        "path": {
          "type": "string",
          "maxLength": 1024
        },
        "size_mb": {
          "type": "number"
        },
        "http_status": {
          "type": "integer"
        },
        "error": {
          "type": "string",
          "maxLength": 2048
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

{
  "name": "matchzy-discord-bot-example",
  "version": "0.1.0",
  "private": true,
  "description": "Boilerplate Discord bot for a MatchZy Auto Tournament instance",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript ../../docs/openapi.json -o src/mat/openapi.d.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

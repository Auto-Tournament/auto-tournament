# Discord bot token, from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, from the same page. Used to register slash commands.
DISCORD_APP_ID=

# Register commands to this guild only. Guild commands appear instantly;
# global ones take up to an hour to propagate, which makes development
# miserable. Leave empty to register globally.
DISCORD_GUILD_ID=

# Your MAT instance, no trailing slash.
MAT_URL=http://localhost:3069

# A token from MAT's API_TOKENS_READONLY. This bot only reads, so give it a
# read-only token — see docs/API.md in the MAT repo.
#   openssl rand -hex 32
MAT_API_TOKEN=
